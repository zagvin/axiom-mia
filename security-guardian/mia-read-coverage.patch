+import {test,expect,beforeEach,afterEach,vi} from 'vitest';
+import {NextRequest} from 'next/server';
+import * as storage from '../storage';
+import {setupSigning,listVisits} from '../visit-store';
+import {login,assignSyntheticVisits,logout,SESSION_COOKIE} from '../local-access';
+import {GET as list} from '@/app/api/visits/route';
+import {GET as exported} from '@/app/api/visits/[id]/export/route';
+const state=vi.hoisted(()=>({duringRender:()=>{},renders:0}));
+vi.mock('../export',()=>({exportToPdf:()=>{state.renders++;return Buffer.from('%PDF-synthetic');},exportToDocx:async()=>{state.renders++;state.duringRender();return Buffer.from('PK-synthetic');}}));
+const pin='739261';let id:string,cookie:string;
+function request(auth=true,format='pdf') {return new NextRequest('http://localhost:3030/api/visits/'+id+'/export?docId=doc&format='+format,{headers:{host:'localhost:3030',...(auth?{cookie}:{})}});}
+const runExport=(auth=true,format='pdf')=>exported(request(auth,format),{params:Promise.resolve({id})});
+beforeEach(()=>{
+ process.env.MIA_GUARDIAN_ACCEPTANCE='1';state.renders=0;state.duringRender=()=>{};
+ storage.writeState({version:1,practice:null,visits:[]});
+ setupSigning({physicianName:'Synthetic',practiceName:'Synthetic',language:'English'},pin);
+ id=listVisits()[0].id;cookie=SESSION_COOKIE+'='+login(pin);
+});
+afterEach(()=>{vi.restoreAllMocks();delete process.env.MIA_GUARDIAN_ACCEPTANCE;});
+function assign(){assignSyntheticVisits(request(),pin,[id]);}
+function signed(){const s=storage.readState();s.visits.find(v=>v.id===id)!.documents=[{id:'doc',type:'soap_note',status:'signed'} as typeof s.visits[number]['documents'][number]];storage.writeState(s);}
+test('list denies anonymous access, then filters unassigned, foreign and nonsynthetic visits',async()=>{
+ expect((await list(request(false))).status).toBe(401);
+ expect(await (await list(request())).json()).toEqual([]);
+ assign();const result=await list(request());expect(result.headers.get('cache-control')).toBe('no-store');expect((await result.json()).map((v:{id:string})=>v.id)).toEqual([id]);
+ const s=storage.readState();s.accessSecurity!.visitOwners[id]='other';storage.writeState(s);expect(await (await list(request())).json()).toEqual([]);
+ s.accessSecurity!.visitOwners[id]=s.accessSecurity!.actorId;s.visits.find(v=>v.id===id)!.isSynthetic=false;storage.writeState(s);expect(await (await list(request())).json()).toEqual([]);
+});
+test('export denies anonymous and unassigned requests before rendering',async()=>{
+ signed();expect((await runExport(false)).status).toBe(401);expect((await runExport()).status).toBe(403);expect(state.renders).toBe(0);
+});
+test('assigned signed PDF/DOCX export succeeds with no-store and audit',async()=>{
+ assign();signed();for(const format of ['pdf','docx']){const r=await runExport(true,format);expect(r.status).toBe(200);expect(r.headers.get('cache-control')).toBe('no-store');expect((await r.arrayBuffer()).byteLength).toBeGreaterThan(0);}
+ expect(storage.readState().accessAudit!.filter(e=>e.type==='visit_export_prepared')).toHaveLength(2);
+});
+test('revocation during asynchronous export withholds bytes',async()=>{
+ assign();signed();state.duringRender=()=>logout(request());const r=await runExport(true,'docx');expect(r.status).toBe(403);expect(await r.text()).not.toContain('PK-synthetic');
+});
+test('scope change during asynchronous export withholds bytes',async()=>{
+ assign();signed();state.duringRender=()=>{const s=storage.readState();s.accessSecurity!.visitOwners[id]='other';storage.writeState(s);};expect((await runExport(true,'docx')).status).toBe(403);
+});
+test('audit failure blocks list and export',async()=>{
+ assign();signed();vi.spyOn(storage,'writeState').mockImplementation(()=>{throw new Error('synthetic private path');});
+ for(const r of [await list(request()),await runExport()]){expect(r.status).toBe(503);expect(await r.text()).not.toContain('private path');}expect(state.renders).toBe(0);
+});
+test('completion audit failure withholds already-rendered export',async()=>{
+ assign();signed();state.duringRender=()=>{vi.spyOn(storage,'writeState').mockImplementation(()=>{throw new Error('storage failed');});};
+ const r=await runExport(true,'docx');expect(state.renders).toBe(1);expect(r.status).toBe(503);expect(await r.text()).not.toContain('PK-synthetic');
+});
