+import { NextRequest, NextResponse } from 'next/server';
+import { sessionIdentity, durableAccessAudit, accessUnavailable } from './local-access';
+import { readState } from './storage';
+export function guardedVisits(request: NextRequest): Response {
+  const headers = { 'Cache-Control': 'no-store' };
+  try {
+    const identity = sessionIdentity(request);
+    if (!identity) {
+      durableAccessAudit({at:new Date().toISOString(),type:'visit_list_denied',outcome:'unauthenticated'});
+      return NextResponse.json({error:'Login required.'},{status:401,headers});
+    }
+    const state=readState();
+    const owners=state.accessSecurity?.visitOwners;
+    // Filter before serializing. Never infer ownership or initialize sample visits here.
+    const visits=state.visits.filter(v=>v.isSynthetic===true && owners &&
+      Object.hasOwn(owners,v.id) && owners[v.id]===identity.actorId)
+      .sort((a,b)=>b.createdAt.localeCompare(a.createdAt));
+    durableAccessAudit({at:new Date().toISOString(),type:'visit_list_completed',actorId:identity.actorId,action:'read_patient',outcome:'success'});
+    return NextResponse.json(visits,{headers});
+  } catch {
+    accessUnavailable();
+    return NextResponse.json({error:'Security storage unavailable.'},{status:503,headers});
+  }
+}
