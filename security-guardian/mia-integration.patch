@@ -0,0 +1,35 @@
+import { NextRequest, NextResponse } from "next/server";
+import { SecurityGuardian } from "./security-guardian/guardian.mjs";
+import { guardRoute } from "./security-guardian/route-handler.mjs";
+import { sessionIdentity, visitOwner, durableAccessAudit, accessUnavailable } from "./local-access";
+import { readState } from "./storage";
+type Context = { params: Promise<{ id: string }> };
+export async function guardedVisit(request: NextRequest, context: Context): Promise<Response> {
+  let actorId: string | undefined;
+  let id: string;
+  const guardian = new SecurityGuardian({ audit: durableAccessAudit });
+  const wrapped = guardRoute(guardian, {
+    action: "read_patient",
+    getIdentity: () => {
+      const identity = sessionIdentity(request);
+      actorId = identity?.actorId;
+      return identity;
+    },
+    resolveResourceOwner: async () => { id = (await context.params).id; return visitOwner(id); },
+  }, () => {
+    // Recheck after asynchronous authorization; return only the authorized synthetic snapshot.
+    const identity = sessionIdentity(request);
+    if (!identity || identity.actorId !== actorId || visitOwner(id) !== actorId)
+      return NextResponse.json({ error: "Access changed." }, { status: 403, headers: { "Cache-Control": "no-store" } });
+    const visit = readState().visits.find(v => v.id === id && v.isSynthetic === true);
+    if (!visit) return NextResponse.json({ error: "Visit unavailable." }, { status: 403 });
+    durableAccessAudit({ at: new Date().toISOString(), type: "visit_read_completed", actorId,
+      action: "read_patient", outcome: "success" });
+    return NextResponse.json(visit, { headers: { "Cache-Control": "no-store" } });
+  });
+  try { return await wrapped(request, context); }
+  catch {
+    accessUnavailable();
+    return NextResponse.json({ error: "Security storage unavailable." }, { status: 503, headers: { "Cache-Control": "no-store" } });
+  }
+}
diff --git a/lib/local-access.ts b/lib/local-access.ts
new file mode 100644
index 0000000..cc88364
--- /dev/null
+++ b/lib/local-access.ts
@@ -0,0 +1,99 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { readState, writeState, AccessEvent } from "./storage";
+import { verifySessionPin, SigningError } from "./visit-store";
+
+export const SESSION_COOKIE = "mia_local_session";
+export const SESSION_SECONDS = 30 * 60;
+export const integrationEnabled = () => process.env.MIA_GUARDIAN_ACCEPTANCE === "1";
+const digest = (token: string) => createHash("sha256").update(token).digest("hex");
+const event = (type: string, actorId?: string): AccessEvent => ({
+  at: new Date().toISOString(), type, ...(actorId ? { actorId } : {}),
+});
+export function accessUnavailable(): void {
+  // Never log raw filesystem errors, credentials, request data, or patient data.
+  console.error("MIA local access unavailable; security storage requires attention.");
+}
+export function localRequest(request: Request, mutation = false): boolean {
+  const host = request.headers.get("host") || "";
+  if (!/^(127\.0\.0\.1|localhost|\[::1\])(?::\d{1,5})?$/i.test(host)) return false;
+  if (request.headers.get("sec-fetch-site") === "cross-site") return false;
+  const url = new URL(request.url);
+  // Next may normalize a loopback URL to localhost while preserving the Host header.
+  const hostUrl = new URL("http://" + host);
+  if (url.protocol !== "http:" || !["localhost", "127.0.0.1", "[::1]"].includes(url.hostname) ||
+      url.port !== hostUrl.port) return false;
+  return !mutation || request.headers.get("origin") === hostUrl.origin;
+}
+export function sessionToken(request: Request): string | null {
+  const entries = (request.headers.get("cookie") || "").split(";")
+    .map(v => v.trim()).filter(v => v.startsWith(SESSION_COOKIE + "="));
+  if (entries.length !== 1) return null;
+  const token = entries[0].slice(SESSION_COOKIE.length + 1);
+  return /^[a-f0-9]{64}$/.test(token) ? token : null;
+}
+export function sessionIdentity(request: Request) {
+  if (!localRequest(request)) return null;
+  const token = sessionToken(request);
+  if (!token) return null;
+  const access = readState().accessSecurity;
+  if (!access || !access.sessions.some(s => s.digest === digest(token) && s.expiresAt > Date.now())) return null;
+  return { actorId: access.actorId, role: "physician" };
+}
+export function login(pin: unknown): string {
+  verifySessionPin(pin);
+  const state = readState();
+  const access = state.accessSecurity ||= { actorId: randomUUID(), sessions: [], visitOwners: {} };
+  const token = randomBytes(32).toString("hex");
+  access.sessions = access.sessions.filter(s => s.expiresAt > Date.now()).slice(-4);
+  access.sessions.push({ digest: digest(token), expiresAt: Date.now() + SESSION_SECONDS * 1000 });
+  (state.accessAudit ||= []).push(event("session_created", access.actorId));
+  writeState(state); // Token is returned only after the vault and audit are durably saved.
+  return token;
+}
+export function logout(request: Request): void {
+  const token = sessionToken(request);
+  const state = readState();
+  if (state.accessSecurity && token) {
+    state.accessSecurity.sessions = state.accessSecurity.sessions.filter(s => s.digest !== digest(token));
+    (state.accessAudit ||= []).push(event("session_revoked", state.accessSecurity.actorId));
+    writeState(state);
+  }
+}
+export function assignSyntheticVisits(request: Request, pin: unknown, ids: unknown): void {
+  if (!Array.isArray(ids) || !ids.length || ids.length > 100 ||
+      ids.some(id => typeof id !== "string" || !/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$/.test(id))) {
+    throw new SigningError("Explicit visit IDs required.", 400);
+  }
+  const identity = sessionIdentity(request);
+  if (!identity) throw new SigningError("Login required.", 401);
+  verifySessionPin(pin);
+  const state = readState();
+  const access = state.accessSecurity!;
+  // Never infer ownership for existing data or accept an actor/role from the client.
+  for (const id of ids) {
+    const visit = state.visits.find(v => v.id === id);
+    if (!visit || visit.isSynthetic !== true) throw new SigningError("Synthetic visit required.", 403);
+    if (Object.hasOwn(access.visitOwners, id) && access.visitOwners[id] !== identity.actorId)
+      throw new SigningError("Visit already belongs to another actor.", 403);
+  }
+  for (const id of ids) access.visitOwners[id] = identity.actorId;
+  (state.accessAudit ||= []).push(event("synthetic_scope_assigned", identity.actorId));
+  writeState(state);
+}
+export function visitOwner(id: string): string | null {
+  const state = readState();
+  if (!state.visits.some(v => v.id === id && v.isSynthetic === true)) return null;
+  const owners = state.accessSecurity?.visitOwners;
+  return owners && Object.hasOwn(owners, id) ? owners[id] : null;
+}
+export function durableAccessAudit(value: AccessEvent, signal?: AbortSignal): void {
+  signal?.throwIfAborted();
+  const state = readState();
+  const safe: AccessEvent = { at: value.at, type: value.type };
+  // Callers supply fixed event/action/outcome strings and server-generated actor IDs only.
+  for (const key of ["actorId", "action", "outcome"] as const)
+    if (typeof value[key] === "string") safe[key] = value[key]!.slice(0, 128);
+  (state.accessAudit ||= []).push(safe);
+  signal?.throwIfAborted();
+  try { writeState(state); } catch { accessUnavailable(); throw new Error("Audit unavailable"); }
+}
