+import { NextRequest, NextResponse } from 'next/server';
+import { SecurityGuardian } from './security-guardian/guardian.mjs';
+import { guardRoute } from './security-guardian/route-handler.mjs';
+import { sessionIdentity, visitOwner, durableAccessAudit, accessUnavailable, localRequest } from './local-access';
+import { SigningError } from './visit-store';
+type Context={params:Promise<{id:string}>};
+type Commit=<T>(write:()=>T)=>T;
+export async function guardedMutation(request:NextRequest,context:Context,action:'write_note'|'approve_note',handler:(commit:Commit)=>Response|Promise<Response>):Promise<Response>{
+ const deny=(message:string,status:number)=>NextResponse.json({error:message},{status,headers:{'Cache-Control':'no-store'}});
+ if(!localRequest(request,true))return deny('Local same-origin request required.',403);
+ let actorId:string|undefined,id:string;
+ const guardian=new SecurityGuardian({audit:durableAccessAudit});
+ const wrapped=guardRoute(guardian,{
+  action,
+  getIdentity:()=>{const who=sessionIdentity(request);actorId=who?.actorId;return who;},
+  resolveResourceOwner:async()=>{id=(await context.params).id;return visitOwner(id);},
+ },async()=>{
+  const check=()=>{const who=sessionIdentity(request);if(!who||who.actorId!==actorId||visitOwner(id)!==actorId)throw new SigningError('Access changed. Nothing was saved by this operation.',403);};
+  check();
+  const commit:Commit=write=>{
+   // Only synchronous store operations belong here. No yield between final
+   // authorization, durable intent and the store write in this single process.
+   check();
+   durableAccessAudit({at:new Date().toISOString(),type:'visit_mutation_authorized',actorId,action,outcome:'authorized'});
+   return write();
+  };
+  const response=await handler(commit);response.headers.set('Cache-Control','no-store');return response;
+ });
+ try{return await wrapped(request,context);}catch(error){
+  if(error instanceof SigningError)return deny(error.message,error.status);
+  accessUnavailable();return deny('Operation unavailable. Check the saved state before retrying.',503);
+ }
+}
