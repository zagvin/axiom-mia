@@ -0,0 +1,144 @@
+import { test, expect, beforeEach, afterEach, vi } from "vitest";
+import { NextRequest } from "next/server";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import * as storage from "../storage";
+import { setupSigning, listVisits, resetSigningPin } from "../visit-store";
+import { POST, GET as sessionStatus } from "@/app/api/session/route";
+import { GET } from "@/app/api/visits/[id]/route";
+import { SESSION_COOKIE, SESSION_SECONDS, sessionIdentity, localRequest } from "../local-access";
+const pin = "739261";
+let recovery: string, id: string;
+function req(body?: object, cookie?: string, headers: Record<string, string> = {}) {
+  return new NextRequest("http://localhost:3030/api/session", {
+    method: body ? "POST" : "GET",
+    headers: { host: "localhost:3030", origin: "http://localhost:3030", ...(cookie ? { cookie } : {}), ...headers },
+    ...(body ? { body: JSON.stringify(body) } : {}),
+  });
+}
+async function login() {
+  const response = await POST(req({ action: "login", pin, actorId: "attacker", role: "service" }));
+  expect(response.status).toBe(200);
+  return response.headers.get("set-cookie")!.split(";")[0];
+}
+const visit = (cookie?: string) => GET(req(undefined, cookie), { params: Promise.resolve({ id }) });
+const assign = (cookie: string, visitIds: unknown = [id]) => POST(req({ action: "assign-synthetic-visits", pin, visitIds }, cookie));
+beforeEach(() => {
+  process.env.MIA_GUARDIAN_ACCEPTANCE = "1";
+  storage.writeState({ version: 1, practice: null, visits: [] });
+  recovery = setupSigning({ physicianName: "Synthetic Physician", practiceName: "Synthetic", language: "Mandarin" }, pin);
+  id = listVisits()[0].id;
+});
+afterEach(() => { vi.restoreAllMocks(); vi.useRealTimers(); delete process.env.MIA_GUARDIAN_ACCEPTANCE; });
+
+test("login creates an opaque HttpOnly Strict cookie; client identity is ignored and secrets are absent from disk", async () => {
+  const response = await POST(req({ action: "login", pin, actorId: "attacker", role: "service" }));
+  const cookie = response.headers.get("set-cookie")!;
+  expect(cookie).toContain("HttpOnly"); expect(cookie).toContain("SameSite=strict");
+  expect(cookie).toContain("Max-Age=1800");
+  const token = cookie.split(";")[0].split("=")[1];
+  expect(token).toMatch(/^[a-f0-9]{64}$/);
+  expect(JSON.stringify(storage.readState())).not.toContain(token);
+  expect(sessionIdentity(req(undefined, cookie.split(";")[0]))).toMatchObject({ role: "physician" });
+  expect(sessionIdentity(req(undefined, cookie.split(";")[0]))!.actorId).not.toBe("attacker");
+  const disk = readFileSync(join(storage.dataDirectory(), "vault.enc"));
+  for (const secret of [pin, token, recovery, "session_created"]) expect(disk.includes(Buffer.from(secret))).toBe(false);
+});
+test("no session denies before reading visits; a login never grants ownership automatically", async () => {
+  expect((await visit()).status).toBe(401);
+  const cookie = await login();
+  expect((await visit(cookie)).status).toBe(403);
+  expect(storage.readState().accessSecurity!.visitOwners).toEqual({});
+});
+test("explicit synthetic assignment permits GET with durable grant and completion events", async () => {
+  const cookie = await login();
+  expect((await assign(cookie)).status).toBe(200);
+  const response = await visit(cookie);
+  expect(response.status).toBe(200); expect((await response.json()).id).toBe(id);
+  expect(response.headers.get("cache-control")).toBe("no-store");
+  expect(storage.readState().accessAudit!.slice(-2).map(e => e.type))
+    .toEqual(["authorization_granted", "visit_read_completed"]);
+});
+test("foreign owner cannot be read or reassigned by a physician", async () => {
+  const cookie = await login();
+  const state = storage.readState(); state.accessSecurity!.visitOwners[id] = "other"; storage.writeState(state);
+  expect((await visit(cookie)).status).toBe(403);
+  expect((await assign(cookie)).status).toBe(403);
+  expect(storage.readState().accessSecurity!.visitOwners[id]).toBe("other");
+});
+test("assignment refuses missing/non-synthetic visits atomically", async () => {
+  const cookie = await login();
+  const state = storage.readState(); state.visits[1].isSynthetic = false; storage.writeState(state);
+  expect((await assign(cookie, [id, state.visits[1].id])).status).toBe(403);
+  expect((await assign(cookie, ["missing"])).status).toBe(403);
+  expect(storage.readState().accessSecurity!.visitOwners).toEqual({});
+});
+test("a previously assigned visit changed to non-synthetic is denied", async () => {
+  const cookie = await login(); await assign(cookie);
+  const state = storage.readState(); state.visits.find(v => v.id === id)!.isSynthetic = false; storage.writeState(state);
+  expect((await visit(cookie)).status).toBe(403);
+});
+test("forged and duplicate cookies deny; headers cannot impersonate a session", async () => {
+  const cookie = await login();
+  for (const bad of [SESSION_COOKIE + "=" + "0".repeat(64), cookie + "; " + cookie, SESSION_COOKIE + "=bad"]) {
+    expect((await visit(bad)).status).toBe(401);
+  }
+  expect(sessionIdentity(req(undefined, undefined, { "x-actor-id": storage.readState().accessSecurity!.actorId }))).toBeNull();
+});
+test("expiry and logout revoke access, including after module reload", async () => {
+  const cookie = await login(); await assign(cookie);
+  vi.resetModules();
+  const reloaded = await import("../local-access");
+  expect(reloaded.sessionIdentity(req(undefined, cookie))).not.toBeNull();
+  expect((await POST(req({ action: "logout" }, cookie))).status).toBe(200);
+  expect(reloaded.sessionIdentity(req(undefined, cookie))).toBeNull();
+  const newCookie = await login(); vi.useFakeTimers(); vi.setSystemTime(Date.now() + SESSION_SECONDS * 1000 + 1);
+  expect(reloaded.sessionIdentity(req(undefined, newCookie))).toBeNull();
+});
+test("PIN recovery revokes all sessions and preserves visit ownership", async () => {
+  const cookie = await login(); await assign(cookie);
+  const owners = storage.readState().accessSecurity!.visitOwners;
+  resetSigningPin(recovery, "482619");
+  expect(sessionIdentity(req(undefined, cookie))).toBeNull();
+  expect(storage.readState().accessSecurity!.visitOwners).toEqual(owners);
+});
+test("login reuses persisted five-failure lockout and rejects correct PIN during lockout", async () => {
+  for (let i = 0; i < 5; i++) await POST(req({ action: "login", pin: "000000" }));
+  expect((await POST(req({ action: "login", pin }))).status).toBe(429);
+  expect(storage.readState().signingSecurity!.lockedUntil).toBeGreaterThan(Date.now());
+  expect(storage.readState().accessSecurity).toBeUndefined();
+});
+test("cross-site and missing-Origin mutations and foreign Hosts are refused", async () => {
+  const cases: Record<string, string>[] = [{ origin: "http://evil.example" }, { origin: "" },
+    { host: "evil.example" }, { "sec-fetch-site": "cross-site" }];
+  for (const headers of cases) {
+    expect((await POST(req({ action: "login", pin }, undefined, headers))).status).toBe(403);
+  }
+});
+test("Next loopback hostname normalization preserves strict Origin and port checks", () => {
+  expect(localRequest(req(undefined, undefined, { host: "127.0.0.1:3030", origin: "http://127.0.0.1:3030" }), true)).toBe(true);
+  expect(localRequest(req(undefined, undefined, { host: "127.0.0.1:4040", origin: "http://127.0.0.1:4040" }), true)).toBe(false);
+  expect(localRequest(req(undefined, undefined, { host: "127.0.0.1:3030", origin: "http://localhost:3030" }), true)).toBe(false);
+});
+test("audit storage outage returns 503 without visit content", async () => {
+  const cookie = await login(); await assign(cookie);
+  vi.spyOn(storage, "writeState").mockImplementation(() => { throw new Error("private path"); });
+  const response = await visit(cookie);
+  expect(response.status).toBe(503);
+  expect(await response.text()).not.toMatch(/patientLabel|private path/);
+});
+test("completion audit failure also withholds the visit", async () => {
+  const cookie = await login(); await assign(cookie);
+  const original = storage.writeState; let writes = 0;
+  vi.spyOn(storage, "writeState").mockImplementation(state => {
+    if (++writes === 2) throw new Error("private path");
+    original(state);
+  });
+  const response = await visit(cookie);
+  expect(response.status).toBe(503); expect(await response.text()).not.toContain("patientLabel");
+});
+test("new endpoints stay disabled unless the isolated integration is opted into", async () => {
+  delete process.env.MIA_GUARDIAN_ACCEPTANCE;
+  expect((await POST(req({ action: "login", pin }))).status).toBe(404);
+  expect((await sessionStatus(req())).status).toBe(404);
+});
