+// Synthetic-only HTTP acceptance probe. Never points at an existing installation.
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { mkdtempSync, rmSync, renameSync, mkdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { once } from "node:events";
+const directory = mkdtempSync(join(tmpdir(), "mia-access-http-"));
+const port = 3137, base = `http://127.0.0.1:${port}`;
+let server, logs = "";
+const passed = [];
+async function start() {
+  let ready = false;
+  server = spawn(process.execPath, ["node_modules/next/dist/bin/next", "start", "-H", "127.0.0.1", "-p", String(port)], {
+    env: { ...process.env, MIA_DATA_DIR: directory, MIA_GUARDIAN_ACCEPTANCE: "1", NEXT_TELEMETRY_DISABLED: "1" },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  server.stdout.on("data", b => { logs += b; if (String(b).includes("Ready in")) ready = true; });
+  server.stderr.on("data", b => { logs += b; });
+  let last = "";
+  for (let i = 0; i < 100; i++) {
+    if (server.exitCode !== null) throw new Error("Probe server exited");
+    if (!ready) { await new Promise(resolve => setTimeout(resolve, 100)); continue; }
+    try { const r = await fetch(base + "/api/session"); if (r.status === 200) return; last = r.status + " " + await r.text(); }
+    catch (error) { last = error.message + " " + (error.cause?.code || ""); }
+    await new Promise(resolve => setTimeout(resolve, 100));
+  }
+  throw new Error("Probe server did not start: " + last);
+}
+async function stop() {
+  if (server && server.exitCode === null) { const exited = once(server, "exit"); server.kill("SIGTERM"); await exited; }
+}
+const post = (path, body, cookie = "", origin = base) => fetch(base + path, {
+  method: "POST", headers: { "Content-Type": "application/json", Origin: origin, Cookie: cookie },
+  body: JSON.stringify(body),
+});
+const get = (id, cookie = "") => fetch(base + "/api/visits/" + id, { headers: { Cookie: cookie } });
+try {
+  await start();
+  assert.equal((await post("/api/setup", {
+    physicianName: "Synthetic HTTP Physician", practiceName: "Synthetic", language: "Mandarin", pin: "739261",
+  })).status, 200);
+  const visits = await (await fetch(base + "/api/visits")).json();
+  const id = (Array.isArray(visits) ? visits : visits.visits)[0].id;
+  assert.equal((await get(id)).status, 401); passed.push("unauthenticated HTTP denial");
+  assert.equal((await post("/api/session", { action: "login", pin: "739261" }, "", "http://evil.example")).status, 403);
+  passed.push("cross-origin login denial");
+  const login = await post("/api/session", { action: "login", pin: "739261" });
+  assert.equal(login.status, 200);
+  const cookie = login.headers.get("set-cookie").split(";")[0];
+  assert.equal((await get(id, cookie)).status, 403); passed.push("unassigned visit denial after real PIN login");
+  assert.equal((await post("/api/session", { action: "assign-synthetic-visits", pin: "739261", visitIds: [id] }, cookie)).status, 200);
+  assert.equal((await get(id, cookie)).status, 200); passed.push("explicit assignment and authorized HTTP read");
+  await stop(); await start();
+  assert.equal((await get(id, cookie)).status, 200); passed.push("session and scope survive actual server restart");
+  const backup = join(directory, "vault.previous.enc");
+  renameSync(backup, backup + ".saved"); mkdirSync(backup);
+  const outage = await get(id, cookie);
+  assert.equal(outage.status, 503); assert.doesNotMatch(await outage.text(), /patientLabel|vault/);
+  passed.push("durable audit write outage withholds visit");
+  rmSync(backup, { recursive: true }); renameSync(backup + ".saved", backup);
+  assert.equal((await get(id, cookie)).status, 200); passed.push("recovery after storage outage");
+  assert.equal((await post("/api/session", { action: "logout" }, cookie)).status, 200);
+  await stop(); await start();
+  assert.equal((await get(id, cookie)).status, 401); passed.push("logout remains revoked after restart");
+  console.log(JSON.stringify({ passed: passed.length, checks: passed }, null, 2));
+} catch (error) {
+  console.error(error.message); console.error(logs); process.exitCode = 1;
+} finally {
+  await stop(); rmSync(directory, { recursive: true, force: true });
+}
