@@ -0,0 +1,50 @@
+import { NextRequest, NextResponse } from "next/server";
+import { readJson } from "@/lib/request";
+import { SigningError } from "@/lib/visit-store";
+import { integrationEnabled, localRequest, login, logout, sessionIdentity, assignSyntheticVisits,
+  SESSION_COOKIE, SESSION_SECONDS, accessUnavailable } from "@/lib/local-access";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+const reply = (body: object, status = 200) => NextResponse.json(body, {
+  status, headers: { "Cache-Control": "no-store" },
+});
+export async function POST(request: NextRequest) {
+  if (!integrationEnabled()) return reply({ error: "Not enabled." }, 404);
+  if (!localRequest(request, true)) return reply({ error: "Local same-origin request required." }, 403);
+  let value;
+  try { value = await readJson(request, 8192); } catch { return reply({ error: "Invalid request." }, 400); }
+  try {
+    if (value.action === "login") {
+      const token = login(value.pin);
+      const response = reply({ authenticated: true });
+      response.cookies.set(SESSION_COOKIE, token, {
+        httpOnly: true, sameSite: "strict", path: "/", maxAge: SESSION_SECONDS,
+        // This installation binds to loopback HTTP only; never expose it remotely.
+        secure: false,
+      });
+      return response;
+    }
+    if (value.action === "logout") {
+      logout(request);
+      const response = reply({ authenticated: false });
+      response.cookies.set(SESSION_COOKIE, "", { httpOnly: true, sameSite: "strict", path: "/", maxAge: 0 });
+      return response;
+    }
+    if (value.action === "assign-synthetic-visits") {
+      assignSyntheticVisits(request, value.pin, value.visitIds);
+      return reply({ assigned: true });
+    }
+    return reply({ error: "Invalid action." }, 400);
+  } catch (error) {
+    if (error instanceof SigningError) return reply({ error: "Authentication or scope rejected." }, error.status);
+    accessUnavailable();
+    return reply({ error: "Security storage unavailable." }, 503);
+  }
+}
+export async function GET(request: NextRequest) {
+  if (!integrationEnabled()) return reply({ error: "Not enabled." }, 404);
+  if (!localRequest(request)) return reply({ error: "Local request required." }, 403);
+  try { return reply({ authenticated: !!sessionIdentity(request) }); }
+  catch { accessUnavailable(); return reply({ error: "Security storage unavailable." }, 503); }
+}
